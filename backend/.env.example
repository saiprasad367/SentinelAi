# ─── SentinelAI Backend Environment Variables ────────────────────────────────

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-service-key

# PostgreSQL async connection string (pgvector enabled via Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres

# Synchronous URL for Alembic migrations only
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres

# ─── OpenRouter AI ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-haiku
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini
OPENROUTER_STRONG_MODEL=anthropic/claude-3-5-sonnet

# ─── HuggingFace Embeddings ───────────────────────────────────────────────────
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_DEVICE=cpu

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=SentinelAI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS - add your frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ─── Scheduler ────────────────────────────────────────────────────────────────
PREDICTION_SCAN_INTERVAL_MINUTES=5
HEALTH_CHECK_INTERVAL_SECONDS=30
ANALYTICS_AGGREGATION_INTERVAL_MINUTES=15

# ─── Business Impact Thresholds ───────────────────────────────────────────────
REVENUE_PER_MINUTE_USD=1500
CRITICAL_USER_THRESHOLD=10000
